{
    "name": "@mat3ra/ide",
    "version": "0.0.0",
    "description": "Infrastructure DEfinitions",
    "scripts": {
        "test": "nyc --reporter=text mocha --recursive --bail --require ts-node/register 'tests/js/**/*.ts'",
        "lint": "eslint --cache src/js tests/js && prettier --write src/js tests/js",
        "lint:fix": "eslint --fix --cache src/js tests/js && prettier --write src/js tests/js",
        "lint:staged": "lint-staged",
        "prepare": "husky install",
        "prettier": "prettier --check src/js tests/js",
        "transpile": "tsc -p tsconfig-transpile.json",
        "prepublishOnly": "npm run transpile"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/mat3ra/ide.git"
    },
    "main": "dist/js/index.js",
    "types": "dist/js/index.d.ts",
    "files": [
        "/dist",
        "/src/js"
    ],
    "author": "Exabyte Inc.",
    "bugs": {
        "url": "https://github.com/mat3ra/ide/issues"
    },
    "license": "Apache-2.0",
    "homepage": "https://github.com/mat3ra/ide",
    "dependencies": {
        "moment": "^2.31.0",
        "pluralize": "^3.1.0"
    },
    "devDependencies": {
        "@babel/eslint-parser": "^7.29.13",
        "@babel/plugin-proposal-class-properties": "^7.18.6",
        "@babel/preset-env": "^7.29.14",
        "@babel/preset-react": "^7.29.7",
        "@babel/register": "^7.29.13",
        "@babel/runtime-corejs3": "^7.29.15",
        "@mat3ra/code": "^2026.11.25-0",
        "@mat3ra/eslint-config": "^2026.7.12-0",
        "@mat3ra/esse": "^2026.11.25-0",
        "@mat3ra/tsconfig": "^2024.6.3-0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.19.43",
        "@types/pluralize": "^0.0.33",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "chai": "^4.5.0",
        "eslint": "7.32.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-prettier": "^8.10.2",
        "eslint-import-resolver-exports": "^1.0.0-beta.5",
        "eslint-import-resolver-meteor": "^0.4.0",
        "eslint-import-resolver-node": "^0.4.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^50.8.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-mui-path-imports": "^0.0.15",
        "eslint-plugin-prettier": "^4.2.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-simple-import-sort": "^7.0.0",
        "husky": "^7.0.4",
        "lint-staged": "^12.5.0",
        "mixwith": "^0.1.1",
        "mocha": "^9.2.2",
        "nyc": "^15.1.0",
        "prettier": "^2.8.8",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "@mat3ra/code": "*",
        "@mat3ra/esse": "*"
    },
    "engines": {
        "node": ">=14.0.0"
    },
    "lint-staged": {
        "src/js/**/*.js": [
            "eslint --fix --cache",
            "prettier --write"
        ],
        "tests/js/**/*.js": [
            "eslint --fix --cache",
            "prettier --write"
        ]
    }
}
